    </div>

    <!-- ===================================================================== -->
    <!-- LÓGICA JAVASCRIPT (CRUD, ESTADO, LOCALSTORAGE E NAVEGAÇÃO)            -->
    <!-- ===================================================================== -->
    <script>
        // Chaves de armazenamento no navegador (LocalStorage)
        const STORAGE_KEY = 'organiza_planilha_items_v1';
        const USER_KEY = 'organiza_user_name_v1';

        // Estado global da aplicação
        let items = [];
        let itemToDeleteId = null;
        let currentAuthMode = 'login'; // 'login' ou 'register'

        // Dados de exemplo pré-carregados na primeira visita
        const defaultDemoItems = [
            {
                id: 'demo-1',
                title: 'Estruturar metas da startup para Dezembro',
                category: 'Trabalho',
                priority: 'Alta',
                date: new Date().toISOString().split('T')[0],
                value: 0,
                status: 'Em Andamento'
            },
            {
                id: 'demo-2',
                title: 'Reserva de emergência e controle de contas',
                category: 'Finanças',
                priority: 'Alta',
                date: new Date().toISOString().split('T')[0],
                value: 1250.00,
                status: 'Concluído'
            },
            {
                id: 'demo-3',
                title: 'Check-up médico e exames de rotina',
                category: 'Saúde',
                priority: 'Média',
                date: new Date(Date.now() + 86400000 * 3).toISOString().split('T')[0],
                value: 280.00,
                status: 'Pendente'
            },
            {
                id: 'demo-4',
                title: 'Organizar arquivos da pasta NOSSA_STARTUP',
                category: 'Pessoal',
                priority: 'Baixa',
                date: new Date(Date.now() + 86400000 * 5).toISOString().split('T')[0],
                value: 0,
                status: 'Pendente'
            }
        ];

        // Inicialização quando a página termina de carregar
        document.addEventListener('DOMContentLoaded', () => {
            try {
                loadUser();
                loadItems();
                renderTable();
                lucide.createIcons();
            } catch (error) {
                console.error('Erro ao inicializar o ORGANIZA:', error);
            }
        });

        // ---------------------------------------------------------------------
        // GERENCIAMENTO DE DADOS (LOCALSTORAGE)
        // ---------------------------------------------------------------------
        function loadItems() {
            const saved = localStorage.getItem(STORAGE_KEY);
            if (saved) {
                items = JSON.parse(saved);
            } else {
                // Primeira visita: carrega os dados de demonstração
                items = [...defaultDemoItems];
                saveItems();
            }
        }

        function saveItems() {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
            updateStats();
        }

        function resetDemoData() {
            items = [...defaultDemoItems];
            saveItems();
            renderTable();
            showToast('Dados de exemplo restaurados na planilha!');
        }

        // ---------------------------------------------------------------------
        // NAVEGAÇÃO ENTRE LANDING PAGE E PAINEL PRINCIPAL
        // ---------------------------------------------------------------------
        function switchView(viewName) {
            const landingView = document.getElementById('landing-view');
            const dashboardView = document.getElementById('dashboard-view');
            const landingNavLinks = document.getElementById('landing-nav-links');
            const authButtonsGroup = document.getElementById('auth-buttons-group');
            const dashboardNavGroup = document.getElementById('dashboard-nav-group');

            if (viewName === 'dashboard') {
                landingView.classList.add('hidden');
                dashboardView.classList.remove('hidden');
                landingNavLinks.classList.add('hidden');
                authButtonsGroup.classList.add('hidden');
                dashboardNavGroup.classList.remove('hidden');
                renderTable();
            } else {
                dashboardView.classList.add('hidden');
                landingView.classList.remove('hidden');
                landingNavLinks.classList.remove('hidden');
                landingNavLinks.classList.add('md:flex');
                authButtonsGroup.classList.remove('hidden');
                dashboardNavGroup.classList.add('hidden');
            }
            window.scrollTo({ top: 0, behavior: 'smooth' });
            lucide.createIcons();
        }

        // ---------------------------------------------------------------------
        // AUTENTICAÇÃO SIMULADA (LOGIN E CADASTRO)
        // ---------------------------------------------------------------------
        function loadUser() {
            const savedName = localStorage.getItem(USER_KEY);
            if (savedName) {
                document.getElementById('user-name-display').textContent = savedName;
            }
        }

        function openAuthModal(mode) {
            currentAuthMode = mode;
            const modal = document.getElementById('auth-modal');
            const title = document.getElementById('auth-modal-title');
            const nameGroup = document.getElementById('auth-name-group');
            const submitBtn = document.getElementById('auth-submit-btn');
            const toggleBtn = document.getElementById('auth-toggle-mode');

            if (mode === 'register') {
                title.textContent = 'Criar Conta no ORGANIZA';
                nameGroup.classList.remove('hidden');
                submitBtn.textContent = 'Cadastrar e Abrir Planilha';
                toggleBtn.textContent = 'Já possui conta? Faça login aqui';
            } else {
                title.textContent = 'Entrar no ORGANIZA';
                nameGroup.classList.add('hidden');
                submitBtn.textContent = 'Entrar no Meu Painel';
                toggleBtn.textContent = 'Não tem conta? Cadastre-se gratuitamente';
            }

            modal.classList.remove('hidden');
            modal.classList.add('flex');
            lucide.createIcons();
        }

        function closeAuthModal() {
            const modal = document.getElementById('auth-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function toggleAuthMode() {
            openAuthModal(currentAuthMode === 'login' ? 'register' : 'login');
        }

        function handleAuthSubmit(event) {
            event.preventDefault();
            const emailInput = document.getElementById('auth-email').value.trim();
            const nameInput = document.getElementById('auth-name').value.trim();

            let displayName = nameInput;
            if (!displayName && emailInput) {
                // Usa a primeira parte do e-mail caso seja login direto
                displayName = emailInput.split('@')[0];
                displayName = displayName.charAt(0).toUpperCase() + displayName.slice(1);
            }

            if (displayName) {
                localStorage.setItem(USER_KEY, displayName);
                document.getElementById('user-name-display').textContent = displayName;
            }

            closeAuthModal();
            switchView('dashboard');
            showToast(`Bem-vindo(a), ${displayName || 'Usuário'}!`);
        }

        // ---------------------------------------------------------------------
        // OPERAÇÕES CRUD DA PLANILHA (CREATE, READ, UPDATE, DELETE)
        // ---------------------------------------------------------------------

        // READ: Renderiza a tabela filtrada e atualiza os indicadores
        function renderTable() {
            const tbody = document.getElementById('spreadsheet-body');
            const emptyState = document.getElementById('empty-state');
            const searchTerm = document.getElementById('search-input').value.toLowerCase().trim();
            const categoryFilter = document.getElementById('filter-category').value;
            const statusFilter = document.getElementById('filter-status').value;

            // Filtra os registros conforme busca e seletores
            const filteredItems = items.filter(item => {
                const matchesSearch = item.title.toLowerCase().includes(searchTerm) || 
                                      item.category.toLowerCase().includes(searchTerm);
                const matchesCategory = categoryFilter === 'Todas' || item.category === categoryFilter;
                const matchesStatus = statusFilter === 'Todos' || item.status === statusFilter;
                return matchesSearch && matchesCategory && matchesStatus;
            });

            tbody.innerHTML = '';

            if (filteredItems.length === 0) {
                emptyState.classList.remove('hidden');
            } else {
                emptyState.classList.add('hidden');

                filteredItems.forEach((item, index) => {
                    const tr = document.createElement('tr');
                    tr.className = 'spreadsheet-row transition-colors';

                    // Formatação de moeda BRL
                    const formattedValue = Number(item.value || 0).toLocaleString('pt-BR', {
                        style: 'currency',
                        currency: 'BRL'
                    });

                    // Formatação de data DD/MM/AAAA
                    const formattedDate = formatDateBR(item.date);

                    // Badges visuais de Prioridade
                    const priorityBadge = getPriorityBadge(item.priority);

                    // Badges visuais de Status (clicáveis para alternar rápido)
                    const statusBadge = getStatusBadge(item.status);

                    // Estilo riscado suave se estiver concluído
                    const titleStyle = item.status === 'Concluído' 
                        ? 'line-through text-slate-400 font-medium' 
                        : 'text-slate-800 font-semibold';

                    tr.innerHTML = `
                        <td class="py-3.5 px-4 text-center text-xs font-mono text-slate-400">${index + 1}</td>
                        <td class="py-3.5 px-4 ${titleStyle}">${escapeHTML(item.title)}</td>
                        <td class="py-3.5 px-4">
                            <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 text-slate-700 border border-slate-200/80">
                                ${getCategoryIcon(item.category)} ${escapeHTML(item.category)}
                            </span>
                        </td>
                        <td class="py-3.5 px-4">${priorityBadge}</td>
                        <td class="py-3.5 px-4 text-slate-600 text-xs font-medium whitespace-nowrap">${formattedDate}</td>
                        <td class="py-3.5 px-4 text-right font-mono text-xs font-semibold text-slate-700 whitespace-nowrap">${formattedValue}</td>
                        <td class="py-3.5 px-4 text-center">
                            <button onclick="cycleStatus('${item.id}')" title="Clique para alternar o status" class="cursor-pointer transition-transform active:scale-95">
                                ${statusBadge}
                            </button>
                        </td>
                        <td class="py-3.5 px-4 text-right whitespace-nowrap">
                            <div class="inline-flex items-center gap-1">
                                <button onclick="openItemModal('${item.id}')" title="Editar registro" class="p-2 text-slate-500 hover:text-brand-600 hover:bg-brand-50 rounded-lg transition-colors">
                                    <i data-lucide="pencil" class="w-4 h-4"></i>
                                </button>
                                <button onclick="openDeleteModal('${item.id}')" title="Excluir registro" class="p-2 text-slate-500 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors">
                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                </button>
                            </div>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
            }

            updateStats();
            lucide.createIcons();
        }

        // Atualiza os 4 cards de indicadores no topo do painel
        function updateStats() {
            const total = items.length;
            const completed = items.filter(i => i.status === 'Concluído').length;
            const pending = total - completed;
            const totalBudget = items.reduce((acc, curr) => acc + (parseFloat(curr.value) || 0), 0);

            document.getElementById('stat-total').textContent = total;
            document.getElementById('stat-completed').textContent = completed;
            document.getElementById('stat-pending').textContent = pending;
            document.getElementById('stat-budget').textContent = totalBudget.toLocaleString('pt-BR', {
                style: 'currency',
                currency: 'BRL'
            });
        }

        // CREATE / UPDATE: Abre o modal preenchido (edição) ou limpo (novo)
        function openItemModal(id = null) {
            const modal = document.getElementById('item-modal');
            const modalTitle = document.getElementById('modal-title');
            const form = document.getElementById('item-form');

            form.reset();

            if (id) {
                const item = items.find(i => i.id === id);
                if (!item) return;
                modalTitle.textContent = 'Editar Registro';
                document.getElementById('item-id').value = item.id;
                document.getElementById('item-title').value = item.title;
                document.getElementById('item-category').value = item.category;
                document.getElementById('item-priority').value = item.priority;
                document.getElementById('item-date').value = item.date;
                document.getElementById('item-value').value = item.value || '';
                document.getElementById('item-status').value = item.status;
            } else {
                modalTitle.textContent = 'Novo Registro na Planilha';
                document.getElementById('item-id').value = '';
                document.getElementById('item-date').value = new Date().toISOString().split('T')[0];
            }

            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.getElementById('item-title').focus();
            lucide.createIcons();
        }

        function closeItemModal() {
            const modal = document.getElementById('item-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function handleItemSubmit(event) {
            event.preventDefault();

            const id = document.getElementById('item-id').value;
            const title = document.getElementById('item-title').value.trim();
            const category = document.getElementById('item-category').value;
            const priority = document.getElementById('item-priority').value;
            const date = document.getElementById('item-date').value;
            const value = parseFloat(document.getElementById('item-value').value) || 0;
            const status = document.getElementById('item-status').value;

            if (!title) return;

            if (id) {
                // Atualizar existente (Update)
                const index = items.findIndex(i => i.id === id);
                if (index !== -1) {
                    items[index] = { id, title, category, priority, date, value, status };
                    showToast('Registro atualizado com sucesso!');
                }
            } else {
                // Criar novo (Create)
                const newItem = {
                    id: 'item-' + Date.now(),
                    title,
                    category,
                    priority,
                    date,
                    value,
                    status
                };
                items.unshift(newItem);
                showToast('Novo registro adicionado à planilha!');
            }

            saveItems();
            renderTable();
            closeItemModal();
        }

        // UPDATE RÁPIDO: Alterna o status com um clique direto na tabela
        function cycleStatus(id) {
            const order = ['Pendente', 'Em Andamento', 'Concluído'];
            const index = items.findIndex(i => i.id === id);
            if (index !== -1) {
                const currentStatus = items[index].status;
                const nextStatus = order[(order.indexOf(currentStatus) + 1) % order.length];
                items[index].status = nextStatus;
                saveItems();
                renderTable();
                showToast(`Status alterado para "${nextStatus}"`);
            }
        }

        // DELETE: Exclusão com modal de confirmação seguro
        function openDeleteModal(id) {
            const item = items.find(i => i.id === id);
            if (!item) return;
            itemToDeleteId = id;
            document.getElementById('delete-item-name').textContent = `"${item.title}"`;
            const modal = document.getElementById('delete-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            lucide.createIcons();
        }

        function closeDeleteModal() {
            itemToDeleteId = null;
            const modal = document.getElementById('delete-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function confirmDelete() {
            if (!itemToDeleteId) return;
            items = items.filter(i => i.id !== itemToDeleteId);
            saveItems();
            renderTable();
            closeDeleteModal();
            showToast('Registro excluído da planilha.');
        }

        // Limpar filtros de pesquisa
        function clearFilters() {
            document.getElementById('search-input').value = '';
            document.getElementById('filter-category').value = 'Todas';
            document.getElementById('filter-status').value = 'Todos';
            renderTable();
        }

        // ---------------------------------------------------------------------
        // FUNÇÕES AUXILIARES VISUAIS E DE FORMATAÇÃO
        // ---------------------------------------------------------------------
        function getCategoryIcon(category) {
            const icons = {
                'Trabalho': '💼',
                'Pessoal': '🏠',
                'Finanças': '💰',
                'Saúde': '❤️'
            };
            return icons[category] || '📌';
        }

        function getPriorityBadge(priority) {
            if (priority === 'Alta') {
                return `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-200">Alta</span>`;
            }
            if (priority === 'Média') {
                return `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">Média</span>`;
            }
            return `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600 border border-slate-200">Baixa</span>`;
        }

        function getStatusBadge(status) {
            if (status === 'Concluído') {
                return `<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 hover:bg-emerald-100">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span> Concluído
                </span>`;
            }
            if (status === 'Em Andamento') {
                return `<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-brand-50 text-brand-700 border border-brand-200 hover:bg-brand-100">
                    <span class="w-1.5 h-1.5 rounded-full bg-brand-600 animate-pulse"></span> Em Andamento
                </span>`;
            }
            return `<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200 hover:bg-amber-100">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Pendente
            </span>`;
        }

        function formatDateBR(dateStr) {
            if (!dateStr) return '-';
            const parts = dateStr.split('-');
            if (parts.length !== 3) return dateStr;
            return `${parts[2]}/${parts[1]}/${parts[0]}`;
        }

        function escapeHTML(str) {
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }

        let toastTimeout;
        function showToast(message) {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toast-message');
            toastMsg.textContent = message;
            toast.classList.remove('hidden');
            toast.classList.add('flex');

            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.add('hidden');
                toast.classList.remove('flex');
            }, 3000);
        }
    </script>
</body>
</html>
