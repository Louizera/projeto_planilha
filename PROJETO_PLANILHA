

<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ORGANIZA — Seu Organizador de Vida & Projeto Planilha</title>
    <!-- Carregando Tailwind CSS para estilização moderna e responsiva -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Fonte Inter do Google Fonts para legibilidade profissional -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Ícones Lucide via CDN -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            200: '#bfdbfe',
                            300: '#93c5fd',
                            400: '#60a5fa',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            800: '#1e40af',
                            900: '#1e3a8a',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* Ajustes finos de barra de rolagem e transições suaves */
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #0f172a;
        }
        .fade-in {
            animation: fadeIn 0.25s ease-out forwards;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }
        /* Estilo sutil para células da planilha */
        .spreadsheet-row:hover {
            background-color: #f1f5f9;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col antialiased selection:bg-brand-600 selection:text-white">

    <!-- ===================================================================== -->
    <!-- BARRA DE NAVEGAÇÃO SUPERIOR (GLOBAL)                                  -->
    <!-- ===================================================================== -->
    <header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-slate-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <!-- Logotipo e Nome do Projeto -->
            <div class="flex items-center gap-3 cursor-pointer" onclick="switchView('landing')">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-600 to-brand-800 flex items-center justify-center text-white shadow-md shadow-brand-600/20">
                    <i data-lucide="layout-grid" class="w-5 h-5"></i>
                </div>
                <div>
                    <span class="text-xl font-extrabold tracking-tight text-slate-900">ORGANIZA</span>
                    <span class="hidden sm:inline-block ml-2 text-[11px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full bg-brand-50 text-brand-700 border border-brand-200">
                        Projeto Planilha
                    </span>
                </div>
            </div>

            <!-- Navegação Central (Visível na Landing Page) -->
            <nav id="landing-nav-links" class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-600">
                <a href="#sobre" class="hover:text-brand-600 transition-colors">Sobre o Produto</a>
                <a href="#funcionalidades" class="hover:text-brand-600 transition-colors">Funcionalidades</a>
                <a href="#como-funciona" class="hover:text-brand-600 transition-colors">Como Funciona</a>
            </nav>

            <!-- Botões de Ação e Alternância de Tela -->
            <div class="flex items-center gap-2 sm:gap-3">
                <!-- Botões exibidos quando estiver na Landing Page -->
                <div id="auth-buttons-group" class="flex items-center gap-2 sm:gap-3">
                    <button onclick="openAuthModal('login')" class="px-4 py-2 text-sm font-semibold text-slate-700 hover:text-brand-600 hover:bg-slate-100 rounded-xl transition-all">
                        Entrar
                    </button>
                    <button onclick="openAuthModal('register')" class="px-4 py-2 text-sm font-semibold text-white bg-brand-600 hover:bg-brand-700 rounded-xl shadow-sm shadow-brand-600/25 transition-all">
                        Cadastrar
                    </button>
                </div>

                <!-- Botões exibidos quando estiver no Painel Principal -->
                <div id="dashboard-nav-group" class="hidden flex items-center gap-2 sm:gap-3">
                    <span id="user-greeting" class="hidden sm:inline-flex items-center gap-1.5 text-sm font-medium text-slate-600 bg-slate-100 px-3 py-1.5 rounded-xl">
                        <i data-lucide="user-check" class="w-4 h-4 text-brand-600"></i>
                        <span id="user-name-display">Visitante</span>
                    </span>
                    <button onclick="switchView('landing')" class="inline-flex items-center gap-1.5 px-3.5 py-2 text-sm font-semibold text-slate-700 bg-white border border-slate-300 hover:bg-slate-50 rounded-xl transition-all">
                        <i data-lucide="home" class="w-4 h-4"></i>
                        <span>Início</span>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- ===================================================================== -->
    <!-- VISÃO 1: PÁGINA INICIAL (LANDING PAGE)                                -->
    <!-- ===================================================================== -->
    <main id="landing-view" class="flex-1 fade-in">
        
        <!-- Hero Section (Apresentação Principal do Produto) -->
        <section id="sobre" class="relative overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-28 bg-gradient-to-b from-white via-slate-50 to-slate-100/70 border-b border-slate-200">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid lg:grid-cols-12 gap-12 items-center">
                    
                    <!-- Coluna de Texto -->
                    <div class="lg:col-span-6 text-center lg:text-left">
                        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-50 border border-brand-200 text-brand-700 text-xs font-semibold mb-6">
                            <span class="w-2 h-2 rounded-full bg-brand-600 animate-pulse"></span>
                            Versão 1.0 • Simples, Visual e Direto ao Ponto
                        </div>
                        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.12]">
                            Organize sua vida com a clareza de uma <span class="text-brand-600">planilha inteligente.</span>
                        </h1>
                        <p class="mt-6 text-lg text-slate-600 leading-relaxed max-w-2xl mx-auto lg:mx-0">
                            O <strong>ORGANIZA</strong> transforma a bagunça do dia a dia em um painel visual único. Controle tarefas, metas pessoais, prazos e finanças sem complicação — tudo salvo automaticamente no seu navegador.
                        </p>

                        <!-- CTAs Principais -->
                        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
                            <button onclick="switchView('dashboard')" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 text-base font-semibold text-white bg-brand-600 hover:bg-brand-700 rounded-xl shadow-lg shadow-brand-600/25 transition-all hover:-translate-y-0.5">
                                <i data-lucide="table-2" class="w-5 h-5"></i>
                                <span>Acessar Minha Planilha Agora</span>
                            </button>
                            <button onclick="openAuthModal('register')" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 text-base font-semibold text-slate-700 bg-white hover:bg-slate-50 border border-slate-300 rounded-xl transition-all">
                                <i data-lucide="user-plus" class="w-5 h-5 text-brand-600"></i>
                                <span>Criar Conta Gratuita</span>
                            </button>
                        </div>

                        <!-- Selos de Confiança / Benefícios Rápidos -->
                        <div class="mt-8 pt-6 border-t border-slate-200/80 flex flex-wrap items-center justify-center lg:justify-start gap-6 text-sm text-slate-500">
                            <div class="flex items-center gap-2">
                                <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-600"></i>
                                <span>100% em Português</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-600"></i>
                                <span>Salvamento Automático</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-600"></i>
                                <span>Zero Configuração</span>
                            </div>
                        </div>
                    </div>

                    <!-- Coluna Visual: Prévia Estilizada do Painel Planilha -->
                    <div class="lg:col-span-6">
                        <div class="bg-white rounded-2xl shadow-2xl shadow-slate-300/60 border border-slate-200 overflow-hidden">
                            <!-- Barra superior estilo janela -->
                            <div class="bg-slate-900 px-4 py-3 flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <span class="w-3 h-3 rounded-full bg-rose-500"></span>
                                    <span class="w-3 h-3 rounded-full bg-amber-400"></span>
                                    <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
                                </div>
                                <span class="text-xs font-medium text-slate-400">organiza.app / projeto-planilha</span>
                                <span class="text-xs text-brand-400 font-semibold">Ao Vivo</span>
                            </div>
                            <!-- Conteúdo simulado da planilha -->
                            <div class="p-5 sm:p-6 bg-slate-50/60">
                                <div class="grid grid-cols-3 gap-3 mb-5">
                                    <div class="bg-white p-3.5 rounded-xl border border-slate-200/80 shadow-sm">
                                        <p class="text-[11px] font-semibold uppercase text-slate-400">Atividades</p>
                                        <p class="text-xl font-bold text-slate-800 mt-0.5">12 Itens</p>
                                    </div>
                                    <div class="bg-white p-3.5 rounded-xl border border-slate-200/80 shadow-sm">
                                        <p class="text-[11px] font-semibold uppercase text-slate-400">Concluídas</p>
                                        <p class="text-xl font-bold text-emerald-600 mt-0.5">68%</p>
                                    </div>
                                    <div class="bg-white p-3.5 rounded-xl border border-slate-200/80 shadow-sm">
                                        <p class="text-[11px] font-semibold uppercase text-slate-400">Orçamento</p>
                                        <p class="text-xl font-bold text-brand-600 mt-0.5">R$ 2.450</p>
                                    </div>
                                </div>

                                <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm">
                                    <div class="px-4 py-2.5 bg-slate-100 border-b border-slate-200 flex justify-between text-xs font-bold text-slate-600 uppercase">
                                        <span>Atividade / Meta</span>
                                        <span>Status</span>
                                    </div>
                                    <div class="divide-y divide-slate-100 text-sm">
                                        <div class="px-4 py-3 flex items-center justify-between">
                                            <div>
                                                <p class="font-semibold text-slate-800">Planejamento financeiro mensal</p>
                                                <p class="text-xs text-slate-400">Finanças • Prioridade Alta</p>
                                            </div>
                                            <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">Concluído</span>
                                        </div>
                                        <div class="px-4 py-3 flex items-center justify-between">
                                            <div>
                                                <p class="font-semibold text-slate-800">Apresentação Projeto Startup</p>
                                                <p class="text-xs text-slate-400">Trabalho • Prioridade Alta</p>
                                            </div>
                                            <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-brand-50 text-brand-700 border border-brand-200">Em Andamento</span>
                                        </div>
                                        <div class="px-4 py-3 flex items-center justify-between">
                                            <div>
                                                <p class="font-semibold text-slate-800">Consulta médica de rotina</p>
                                                <p class="text-xs text-slate-400">Saúde • Prioridade Média</p>
                                            </div>
                                            <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">Pendente</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- Seção de Funcionalidades Principais -->
        <section id="funcionalidades" class="py-20 bg-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center max-w-3xl mx-auto mb-16">
                    <span class="text-xs font-bold uppercase tracking-widest text-brand-600">Recursos Essenciais</span>
                    <h2 class="mt-2 text-3xl sm:text-4xl font-extrabold text-slate-900">
                        Tudo o que você precisa para ter controle da sua rotina
                    </h2>
                    <p class="mt-4 text-slate-600 text-base sm:text-lg">
                        Projetado para unir a velocidade de uma planilha tradicional com a beleza e praticidade de um aplicativo moderno.
                    </p>
                </div>

                <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
                    <!-- Card 1 -->
                    <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200/80 hover:border-brand-300 hover:shadow-lg hover:shadow-brand-600/5 transition-all">
                        <div class="w-12 h-12 rounded-xl bg-brand-600 text-white flex items-center justify-center mb-5 shadow-md shadow-brand-600/20">
                            <i data-lucide="table" class="w-6 h-6"></i>
                        </div>
                        <h3 class="text-lg font-bold text-slate-900 mb-2">Planilha Inteligente</h3>
                        <p class="text-sm text-slate-600 leading-relaxed">
                            Crie, edite, atualize status com um clique e exclua registros de forma intuitiva em uma tabela limpa e organizada.
                        </p>
                    </div>

                    <!-- Card 2 -->
                    <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200/80 hover:border-brand-300 hover:shadow-lg hover:shadow-brand-600/5 transition-all">
                        <div class="w-12 h-12 rounded-xl bg-slate-800 text-white flex items-center justify-center mb-5 shadow-md">
                            <i data-lucide="wallet" class="w-6 h-6"></i>
                        </div>
                        <h3 class="text-lg font-bold text-slate-900 mb-2">Controle Financeiro</h3>
                        <p class="text-sm text-slate-600 leading-relaxed">
                            Associe valores e orçamentos às suas tarefas e acompanhe automaticamente o balanço total no topo do painel.
                        </p>
                    </div>

                    <!-- Card 3 -->
                    <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200/80 hover:border-brand-300 hover:shadow-lg hover:shadow-brand-600/5 transition-all">
                        <div class="w-12 h-12 rounded-xl bg-brand-600 text-white flex items-center justify-center mb-5 shadow-md shadow-brand-600/20">
                            <i data-lucide="search" class="w-6 h-6"></i>
                        </div>
                        <h3 class="text-lg font-bold text-slate-900 mb-2">Filtros e Busca Rápida</h3>
                        <p class="text-sm text-slate-600 leading-relaxed">
                            Encontre qualquer compromisso em milissegundos filtrando por categoria (Trabalho, Saúde, Finanças) ou status.
                        </p>
                    </div>

                    <!-- Card 4 -->
                    <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200/80 hover:border-brand-300 hover:shadow-lg hover:shadow-brand-600/5 transition-all">
                        <div class="w-12 h-12 rounded-xl bg-slate-800 text-white flex items-center justify-center mb-5 shadow-md">
                            <i data-lucide="hard-drive" class="w-6 h-6"></i>
                        </div>
                        <h3 class="text-lg font-bold text-slate-900 mb-2">Armazenamento Local</h3>
                        <p class="text-sm text-slate-600 leading-relaxed">
                            Seus dados ficam salvos automaticamente no seu dispositivo via LocalStorage. Feche e volte quando quiser sem perder nada.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Seção Como Funciona / Chamada Final -->
        <section id="como-funciona" class="py-16 bg-slate-900 text-white">
            <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
                <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
                    Pronto para colocar sua rotina nos trilhos?
                </h2>
                <p class="mt-4 text-slate-300 text-lg max-w-2xl mx-auto">
                    Experimente agora mesmo o painel interativo do <strong>Projeto Planilha</strong>. Já deixamos alguns exemplos prontos para você testar!
                </p>
                <div class="mt-8 flex flex-wrap justify-center gap-4">
                    <button onclick="switchView('dashboard')" class="px-8 py-4 text-base font-bold text-slate-900 bg-white hover:bg-brand-50 rounded-xl shadow-lg transition-all">
                        Abrir Painel Principal
                    </button>
                    <button onclick="openAuthModal('login')" class="px-8 py-4 text-base font-semibold text-white bg-brand-600 hover:bg-brand-500 rounded-xl border border-brand-500 transition-all">
                        Fazer Login
                    </button>
                </div>
            </div>
        </section>
    </main>

    <!-- ===================================================================== -->
    <!-- VISÃO 2: PAINEL PRINCIPAL (DASHBOARD CRUD - PROJETO PLANILHA)         -->
    <!-- ===================================================================== -->
    <section id="dashboard-view" class="hidden flex-1 py-8 bg-slate-50 fade-in">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Cabeçalho do Painel -->
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
                <div>
                    <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-brand-600 mb-1">
                        <i data-lucide="folder-kanban" class="w-4 h-4"></i>
                        <span>Workspace Pessoal • Salvamento Automático Ativo</span>
                    </div>
                    <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900">
                        Painel Projeto Planilha
                    </h1>
                    <p class="text-sm text-slate-500 mt-1">
                        Gerencie suas tarefas, metas e orçamento diário em um só lugar.
                    </p>
                </div>

                <!-- Botões de Ação do Painel -->
                <div class="flex flex-wrap items-center gap-3">
                    <button onclick="resetDemoData()" title="Restaurar itens de exemplo" class="inline-flex items-center gap-2 px-3.5 py-2.5 text-sm font-medium text-slate-600 bg-white hover:bg-slate-100 border border-slate-300 rounded-xl transition-all">
                        <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                        <span>Restaurar Exemplos</span>
                    </button>
                    <button onclick="openItemModal()" class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-semibold text-white bg-brand-600 hover:bg-brand-700 rounded-xl shadow-md shadow-brand-600/20 transition-all">
                        <i data-lucide="plus" class="w-5 h-5"></i>
                        <span>Novo Registro</span>
                    </button>
                </div>
            </div>

            <!-- Cards de Resumo / Indicadores (KPIs) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
                <!-- Total de Itens -->
                <div class="bg-white p-5 rounded-2xl border border-slate-200/90 shadow-sm flex items-center justify-between">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Total de Registros</p>
                        <p id="stat-total" class="text-2xl font-extrabold text-slate-900 mt-1">0</p>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-slate-100 text-slate-700 flex items-center justify-center">
                        <i data-lucide="layers" class="w-6 h-6"></i>
                    </div>
                </div>

                <!-- Concluídas -->
                <div class="bg-white p-5 rounded-2xl border border-slate-200/90 shadow-sm flex items-center justify-between">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Concluídos</p>
                        <p id="stat-completed" class="text-2xl font-extrabold text-emerald-600 mt-1">0</p>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                        <i data-lucide="check-circle-2" class="w-6 h-6"></i>
                    </div>
                </div>

                <!-- Pendentes / Em Andamento -->
                <div class="bg-white p-5 rounded-2xl border border-slate-200/90 shadow-sm flex items-center justify-between">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Pendentes / Ativos</p>
                        <p id="stat-pending" class="text-2xl font-extrabold text-amber-600 mt-1">0</p>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
                        <i data-lucide="clock" class="w-6 h-6"></i>
                    </div>
                </div>

                <!-- Balanço Financeiro -->
                <div class="bg-white p-5 rounded-2xl border border-slate-200/90 shadow-sm flex items-center justify-between">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Orçamento Total</p>
                        <p id="stat-budget" class="text-2xl font-extrabold text-brand-600 mt-1">R$ 0,00</p>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center">
                        <i data-lucide="banknote" class="w-6 h-6"></i>
                    </div>
                </div>
            </div>

            <!-- Barra de Busca e Filtros -->
            <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm mb-6">
                <div class="grid grid-cols-1 md:grid-cols-12 gap-3">
                    <!-- Campo de Pesquisa -->
                    <div class="md:col-span-5 relative">
                        <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                        <input type="text" id="search-input" oninput="renderTable()" placeholder="Buscar por título ou anotação..." 
                            class="w-full pl-10 pr-4 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500 focus:bg-white transition-all">
                    </div>

                    <!-- Filtro por Categoria -->
                    <div class="md:col-span-3">
                        <select id="filter-category" onchange="renderTable()" 
                            class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500 focus:bg-white transition-all">
                            <option value="Todas">Todas as Categorias</option>
                            <option value="Trabalho">💼 Trabalho</option>
                            <option value="Pessoal">🏠 Pessoal</option>
                            <option value="Finanças">💰 Finanças</option>
                            <option value="Saúde">❤️ Saúde</option>
                        </select>
                    </div>

                    <!-- Filtro por Status -->
                    <div class="md:col-span-3">
                        <select id="filter-status" onchange="renderTable()" 
                            class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500 focus:bg-white transition-all">
                            <option value="Todos">Todos os Status</option>
                            <option value="Pendente">⏳ Pendente</option>
                            <option value="Em Andamento">🔄 Em Andamento</option>
                            <option value="Concluído">✅ Concluído</option>
                        </select>
                    </div>

